{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block,featured product block, and the product card block.

  @param {product} product_resource - The product to render
  @param {boolean} [show_unit_price] - Whether to show the unit price
  @param {boolean} [show_sale_price_first] - Whether to show the sale price first
{%- enddoc -%}

{% render 'price-styles' %}

{%- liquid
  assign show_unit_price = show_unit_price | default: false
  assign show_sale_price_first = show_sale_price_first | default: false
  assign selected_variant = product_resource.selected_or_first_available_variant
  assign price = selected_variant.price
  assign compare_at_price = selected_variant.compare_at_price

  assign show_compare_price = false
  if compare_at_price > price
    assign show_compare_price = true
  endif

  if product_resource == blank
    assign price = 1999
  endif

  # Check if variant has volume pricing
  assign has_volume_pricing = null
  assign price_min = null
  assign price_max = null

  # For product cards (collection/search pages), calculate min/max across all variants
  # For product pages, only use the selected variant's pricing
  assign is_product_card = false
  if template.name != 'product'
    assign is_product_card = true
  endif

  if is_product_card
    assign price_min = product_resource.price_min
    assign price_max = product_resource.price_max
    assign has_volume_pricing = product_resource.quantity_price_breaks_configured? | default: false
  else
    # Product page: only use selected variant's pricing
    if selected_variant.quantity_price_breaks.size > 0
      assign has_volume_pricing = true
      assign price_min = selected_variant.quantity_price_breaks.last.price
      assign price_max = selected_variant.price
    endif
  endif

  # Determine if currency code should be shown
  assign use_currency = false
  if product.handle == product_resource.handle
    if settings.currency_code_enabled_product_pages
      assign use_currency = true
    endif
  elsif settings.currency_code_enabled_product_cards
    assign use_currency = true
  endif

  # Format all prices
  if use_currency
    assign price = price | money_with_currency
    assign compare_at_price = compare_at_price | money_with_currency
    assign price_min = price_min | money_with_currency
    assign price_max = price_max | money_with_currency
  else
    assign price = price | money
    assign compare_at_price = compare_at_price | money
    assign price_min = price_min | money
    assign price_max = price_max | money
  endif

  # Imprint House: show the rupee sign (the store's money format still says "Rs.")
  assign price = price | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹'
  assign compare_at_price = compare_at_price | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹'
  assign price_min = price_min | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹'
  assign price_max = price_max | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹'

  # Imprint House: bulk packs are 50 pieces/kits, so also show the price per piece
  assign ih_per = ''
  assign ih_unit = 'piece'
  for ih_o in selected_variant.options
    if ih_o contains '50 pieces' or ih_o contains '50 kits'
      assign ih_cents = selected_variant.price | divided_by: 50
      assign ih_per = ih_cents | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹'
      if ih_o contains 'kits'
        assign ih_unit = 'set'
      endif
    endif
  endfor
  # Newer setup: the bulk variant IS the per-piece price ("Bulk order (min. 25 pcs)"); MOQ and free-shipping qty come from metafields
  assign ih_mode = 'pack'
  assign ih_moq = 50
  assign ih_free = 0
  if selected_variant.title contains 'min.'
    assign ih_mode = 'unit'
    assign ih_per = selected_variant.price | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹'
    assign ih_unit = 'piece'
    if selected_variant.title contains 'sets'
      assign ih_unit = 'set'
    endif
    assign ih_moq = product_resource.metafields.custom.moq.value | default: 50
    assign ih_free = product_resource.metafields.custom.free_ship_qty.value | default: 0
  endif
  assign ih_main = false
  if template.name == 'product' and product.handle == product_resource.handle
    assign ih_main = true
  endif
-%}

<div ref="priceContainer">
  {% if ih_per != '' %}
    {% comment %} Imprint House: per-piece price first; the 50-pack total and MOQ underneath {% endcomment %}
    {%- liquid
      assign ih_abbr = 'pcs'
      if ih_unit == 'set'
        assign ih_abbr = 'sets'
      endif
    -%}
    {% if is_product_card %}
      <span class="price"><bdi>{{ ih_per }}</bdi> <small class="ih-unit">/ {{ ih_unit }}</small></span>
      <span class="ih-per">MOQ {{ ih_moq }} {{ ih_abbr }}</span>
    {% elsif ih_mode == 'unit' %}
      <span class="price{% if ih_main %} ih-main-price{% endif %}"><bdi>{{ ih_per }}</bdi> <small class="ih-unit">/ {{ ih_unit }}</small></span>
      <span class="ih-per">(MOQ {{ ih_moq }} {{ ih_abbr }}){% if ih_free > 0 %} · Free shipping on {{ ih_free }}+ {{ ih_abbr }}{% else %} · Free shipping on bulk orders{% endif %}</span>
      <span class="ih-per">Inclusive of everything — engraving, packing &amp; taxes</span>
      {%- if ih_main -%}<span class="ih-moq" data-moq="{{ ih_moq }}" hidden></span><span class="ih-moq-msg" hidden>Quantity set to the minimum order of {{ ih_moq }}.</span>{%- endif -%}
    {% else %}
      <span class="price"><bdi>{{ ih_per }}</bdi> <small class="ih-unit">per {{ ih_unit }}</small></span>
      <span class="ih-per">(MOQ 50 {{ ih_unit }}s) · {{ price }} for 50</span>
    {% endif %}
  {% elsif has_volume_pricing %}
    {% comment %} Volume pricing display {% endcomment %}
    {% if show_compare_price %}
      <span class="price-item__group compare-at-price">
        <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>
        <bdi>{{- compare_at_price -}}</bdi>
      </span>
    {% endif %}
    <span class="price-item__group price">
      <span class="visually-hidden">{{ 'content.price_range' | t }}&nbsp;</span>
      <bdi>{{ price_min }} - {{ price_max }}</bdi>
    </span>
  {% else %}
    {% comment %} Standard pricing display: render only the active branch (regular or sale) {% endcomment %}
    {% if show_compare_price %}
      {% if show_sale_price_first %}
        <span class="price-item__group price">
          <span class="visually-hidden">{{ 'content.price_sale' | t }}&nbsp;</span>
          <bdi>{{ price | default: '&nbsp;' }}</bdi>
        </span>
        <span class="price-item__group price-item--regular compare-at-price">
          <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>
          <bdi>{{- compare_at_price -}}</bdi>
        </span>
      {% else %}
        <span class="price-item__group price-item--regular compare-at-price">
          <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>
          <bdi>{{- compare_at_price -}}</bdi>
        </span>
        <span class="price-item__group price">
          <span class="visually-hidden">{{ 'content.price_sale' | t }}&nbsp;</span>
          <bdi>{{ price | default: '&nbsp;' }}</bdi>
        </span>
      {% endif %}
    {% elsif selected_variant.title contains 'Sample' %}
      <span class="price"
        ><bdi>{{ selected_variant.price | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</bdi> <small class="ih-unit">/ sample</small></span
      >
    {% else %}
      <span class="price"
        ><bdi>{{ price | default: '&nbsp;' }}</bdi></span
      >
    {% endif %}
  {% endif %}
  {%- if selected_variant.unit_price and show_unit_price %}
    {%- liquid
      if use_currency
        assign unit_price = selected_variant.unit_price | money_with_currency
      else
        assign unit_price = selected_variant.unit_price | money
      endif
    -%}
    {% render 'unit-price', price: unit_price, measurement: selected_variant.unit_price_measurement %}
  {%- endif -%}
  {%- unless is_product_card -%}
    {%- if ih_per == '' and selected_variant.title contains 'Sample' -%}
      <span class="ih-per">One engraved piece to check before your bulk order</span>
    {%- endif -%}
    {%- if ih_main -%}
      <span class="ih-mock"><span>Free digital mockup first &mdash; nothing is engraved until you approve your design.</span><a href="https://wa.me/919109535267?text={{ 'Hi, I would like a free mockup for: ' | append: product_resource.title | url_encode }}" target="_blank" rel="noopener">Get my mockup on WhatsApp &rarr;</a></span>
    {%- endif -%}
  {%- endunless -%}
</div>
{%- if has_volume_pricing -%}
  <small
    ref="volumePricingNote"
    class="volume-pricing-note"
  >
    {{- 'content.volume_pricing_available' | t -}}
  </small>
{%- endif -%}
