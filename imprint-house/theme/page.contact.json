{"sections":{"ih_hero":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"ih\"><section class=\"ih-band\"><div class=\"wrap\"><span class=\"eb\">The Imprint House</span><h1>{{ page.title }}</h1><p>{% case page.handle %}{% when 'how-it-works' %}From your logo to a finished gift — with zero risk.{% when 'who-we-work-with' %}Gift ideas built for your kind of business.{% when 'our-story' %}A family-run workshop, engraving gifts that last.{% when 'get-a-quote' %}Send your logo. Get a free mockup within 24 hours.{% when 'faq' %}Everything you need to know before you order.{% when 'contact' %}We usually reply on WhatsApp within a few hours.{% else %}Laser-engraved corporate gifts, delivered across India.{% endcase %}</p></div></section></div>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"main":{"type":"main-page","blocks":{"content":{"type":"text","name":"t:names.content","settings":{"width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0,"text":"{{ closest.page.content }}"},"blocks":{}}},"block_order":["content"],"settings":{"content_direction":"column","gap":32,"background_color":"{{ settings.color_palette.background }}","padding-block-start":56,"padding-block-end":0}},"form":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"ih\"><section class=\"ih-sec\" style=\"padding-top:1.5rem\"><div class=\"wrap\">{%- form 'contact', id: 'ih-quote' -%}{%- if form.posted_successfully? -%}<div class=\"ih-ok\"><b>Thank you, we have your request.</b><p style=\"margin:.4rem 0 .9rem\">We reply on WhatsApp or phone within a few hours on working days. For the fastest free mockup, send your logo now:</p><a class=\"btn b-brass\" href=\"https://wa.me/918319267960?text=Hi%2C%20I%20just%20sent%20a%20quote%20request%20on%20your%20website.%20Here%20is%20my%20logo.\" target=\"_blank\" rel=\"noopener\">Send my logo on WhatsApp &rarr;</a></div>{%- endif -%}{%- if form.errors -%}<div class=\"ih-err\">{{ form.errors | default_errors }}</div>{%- endif -%}<div class=\"ih-form\"><div><label for=\"q-name\">Your name *</label><input id=\"q-name\" name=\"contact[name]\" required autocomplete=\"name\"></div><div><label for=\"q-phone\">Phone / WhatsApp *</label><input id=\"q-phone\" name=\"contact[phone]\" type=\"tel\" required autocomplete=\"tel\" inputmode=\"tel\" minlength=\"10\" placeholder=\"+91\"></div><div><label for=\"q-email\">Email *</label><input id=\"q-email\" name=\"contact[email]\" type=\"email\" required autocomplete=\"email\"><span class=\"note\">We send your quote and invoice here.</span></div><div><label for=\"q-biz\">Business name</label><input id=\"q-biz\" name=\"contact[Business name]\" autocomplete=\"organization\"></div><div><label for=\"q-product\">Product</label><select id=\"q-product\" name=\"contact[Product]\"><option>Not sure yet, please suggest</option>{%- for p in collections['all'].products -%}<option>{{ p.title | escape }}</option>{%- endfor -%}</select></div><div><label for=\"q-qty\">Quantity *</label><input id=\"q-qty\" name=\"contact[Quantity]\" type=\"number\" min=\"1\" step=\"1\" required placeholder=\"MOQ 10–50 depending on product\"></div><div><label for=\"q-date\">Needed by</label><input id=\"q-date\" name=\"contact[Needed by]\" type=\"date\"></div><div><label for=\"q-budget\">Budget per piece (optional)</label><input id=\"q-budget\" name=\"contact[Budget per piece]\" placeholder=\"e.g. ₹250\"></div><div class=\"full\"><label for=\"q-msg\">What should we engrave?</label><textarea id=\"q-msg\" name=\"contact[body]\" placeholder=\"Your logo or text, names on each piece, colours, event date, anything else we should know.\"></textarea></div><p class=\"full note\">Logo files can't be attached to this form. After you send it, WhatsApp your logo to +91 83192 67960 (JPG, PNG or PDF, even a phone photo works).</p><div class=\"full\" style=\"display:flex;gap:.7rem;flex-wrap:wrap\"><button type=\"submit\" class=\"btn b-brass\">Send my request &rarr;</button><a class=\"btn b-line\" href=\"https://wa.me/918319267960?text=Hi%2C%20I%27d%20like%20a%20quote%20for%20engraved%20gifts.%20Here%20is%20my%20logo.\" target=\"_blank\" rel=\"noopener\">Or send your logo on WhatsApp</a></div></div>{%- endform -%}</div></section></div>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}}},"order":["ih_hero","main","form"]}