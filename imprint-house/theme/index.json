{"sections":{"hero":{"type":"custom-liquid","settings":{"custom_liquid":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n.ih{--ink:#16181a;--ink2:#23272b;--brass:#b8925a;--brass2:#d9b98a;--paper:#f7f5f1;--line:#e4e0d8;--muted:#6b6b6b;font-family:Inter,system-ui,sans-serif;color:var(--ink)}\n.ih *{box-sizing:border-box}.ih a{text-decoration:none}\n.ih .serif{font-family:Fraunces,Georgia,serif;font-weight:600;letter-spacing:-.02em}\n.ih .wrap{max-width:1240px;margin:0 auto;padding:0 20px}\n.ih .eb{display:inline-flex;align-items:center;gap:.6rem;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--brass);font-weight:600}\n.ih .eb:before{content:\"\";width:28px;height:1px;background:currentColor}\n.ih h2{font-family:Fraunces,Georgia,serif;font-weight:600;font-size:clamp(1.9rem,4vw,3rem);line-height:1.05;letter-spacing:-.02em;margin:.8rem 0 1rem}\n.ih p{line-height:1.65;margin:0}\n.ih .btn{display:inline-flex;align-items:center;gap:.5rem;padding:1rem 1.6rem;font-weight:600;font-size:.92rem;border-radius:999px;transition:transform .2s,background .2s,color .2s}\n.ih .btn:hover{transform:translateY(-2px)}\n.ih .b-brass{background:var(--brass);color:#16181a}.ih .b-brass:hover{background:var(--brass2)}\n.ih .b-ghost{border:1px solid rgba(255,255,255,.35);color:#fff}.ih .b-ghost:hover{background:#fff;color:var(--ink)}\n.ih .b-dark{background:var(--ink);color:#fff}.ih .b-line{border:1px solid var(--ink);color:var(--ink)}.ih .b-line:hover{background:var(--ink);color:#fff}\n.ih .reveal{opacity:0;transform:translateY(24px);transition:opacity .8s ease,transform .8s ease}.ih .reveal.in{opacity:1;transform:none}\n/* hero */\n.ih-hero{background:var(--ink);color:#fff;position:relative;overflow:hidden}\n.ih-hero .g{display:grid;gap:2.5rem;padding-top:clamp(3rem,7vw,6rem);padding-bottom:clamp(3rem,7vw,6rem);align-items:center}@media(max-width:899px){.ih-hero .pic{aspect-ratio:4/3}.ih-hero .stats{gap:1.3rem}.ih-hero .stats b{font-size:1.5rem}.ih-hero .stats span{font-size:.66rem}}\n@media(min-width:900px){.ih-hero .g{grid-template-columns:1.05fr .95fr}}\n.ih-hero h1{font-family:Fraunces,Georgia,serif;font-weight:600;font-size:clamp(2.6rem,6.2vw,5.2rem);line-height:.98;letter-spacing:-.03em;margin:1.2rem 0 1.4rem;color:#fff}\n.ih-hero h1 em{font-style:italic;color:var(--brass2)}\n.ih-hero .lead{color:#c9c9c9;font-size:1.08rem;max-width:520px;margin-bottom:2rem}\n.ih-hero .stats{display:flex;gap:2.2rem;margin-top:2.6rem;flex-wrap:wrap}\n.ih-hero .stats b{display:block;font-family:Fraunces,Georgia,serif;font-size:2rem;color:#fff;font-weight:600}\n.ih-hero .stats span{font-size:.78rem;color:#9a9a9a;letter-spacing:.06em;text-transform:uppercase}\n.ih-hero .pic{position:relative;aspect-ratio:4/5;border-radius:20px;overflow:hidden;background:#2a2e33 center/cover no-repeat}\n.ih-hero .pic:after{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(0,0,0,.55))}\n.ih-hero .scan{position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,#ffd9a0,transparent);box-shadow:0 0 18px 4px rgba(255,190,110,.55);animation:scan 3.2s ease-in-out infinite;z-index:2}\n@keyframes scan{0%{top:12%}50%{top:82%}100%{top:12%}}\n.ih-hero .tag{position:absolute;left:-18px;bottom:28px;z-index:3;background:linear-gradient(135deg,#e9e9e9,#bfc3c7 45%,#f4f4f4 60%,#a9adb2);color:#5b5f63;border-radius:12px;padding:14px 22px;box-shadow:0 18px 40px rgba(0,0,0,.45);font-family:Fraunces,Georgia,serif;font-size:1.15rem;letter-spacing:.08em;text-shadow:0 1px 0 rgba(255,255,255,.7),0 -1px 0 rgba(0,0,0,.35);transform:rotate(-4deg)}\n@media(max-width:899px){.ih-hero .tag{left:12px}}\n/* marquee */\n.ih-mq{background:var(--brass);color:var(--ink);overflow:hidden;white-space:nowrap;padding:14px 0}\n.ih-mq .t{display:inline-block;animation:mq 38s linear infinite;font-family:Fraunces,Georgia,serif;font-size:1.25rem}\n.ih-mq .t span{margin:0 1.4rem}.ih-mq .t i{font-style:normal;opacity:.55}\n@keyframes mq{to{transform:translateX(-50%)}}\n/* packages */\n.ih-sec{padding:clamp(3.5rem,8vw,6.5rem) 0}\n.ih-head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap;margin-bottom:2.6rem}\n.ih-head p{color:var(--muted);max-width:440px}\n.ih-pk{display:grid;gap:20px}@media(min-width:900px){.ih-pk{grid-template-columns:repeat(3,1fr)}}\n.ih-card{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;display:flex;flex-direction:column;transition:transform .3s,box-shadow .3s;color:var(--ink)}\n.ih-card:hover{transform:translateY(-6px);box-shadow:0 24px 50px rgba(0,0,0,.10)}\n.ih-card .im{aspect-ratio:4/3;overflow:hidden;background:#ddd}.ih-card .im img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.ih-card:hover .im img{transform:scale(1.06)}\n.ih-card .bd{padding:1.6rem;display:flex;flex-direction:column;gap:.7rem;flex:1}\n.ih-card .tier{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--brass);font-weight:600}\n.ih-card h3{font-family:Fraunces,Georgia,serif;font-size:1.6rem;margin:0;font-weight:600}\n.ih-card .pr{font-family:Fraunces,Georgia,serif;font-size:2.2rem;font-weight:600}.ih-card .pr small{font-family:Inter,sans-serif;font-size:.85rem;color:var(--muted);font-weight:400}\n.ih-card .inc{color:var(--muted);font-size:.93rem;flex:1}\n.ih-card .go{font-weight:600;font-size:.9rem;border-top:1px solid var(--line);padding-top:1rem;display:flex;justify-content:space-between}\n.ih-card.dark{background:var(--ink);color:#fff;border-color:var(--ink)}.ih-card.dark .inc{color:#b9b9b9}.ih-card.dark .go{border-color:#333}\n.ih-card .pop{position:absolute;top:14px;right:14px;background:var(--brass);color:var(--ink);font-size:.7rem;font-weight:700;letter-spacing:.1em;padding:.35rem .7rem;border-radius:99px;text-transform:uppercase}\n/* engrave demo */\n.ih-demo{background:var(--paper)}\n.ih-demo .g{display:grid;gap:3rem;align-items:center}@media(min-width:900px){.ih-demo .g{grid-template-columns:1fr 1fr}}\n.ih-demo input{width:100%;padding:1.05rem 1.2rem;border:1px solid #cfc9bd;border-radius:14px;font-size:1.05rem;background:#fff;margin:1.4rem 0 1rem;font-family:inherit}\n.ih-demo .chips{display:flex;gap:.5rem;flex-wrap:wrap}\n.ih-demo .chips button{border:1px solid #cfc9bd;background:#fff;border-radius:99px;padding:.5rem 1rem;font:inherit;font-size:.85rem;cursor:pointer}\n.ih-demo .chips button.on{background:var(--ink);color:#fff;border-color:var(--ink)}\n.ih-stage{position:relative;aspect-ratio:1/1;border-radius:24px;background:radial-gradient(circle at 30% 20%,#2e3338,#121416);display:flex;align-items:center;justify-content:center;overflow:hidden}\n.ih-obj{transition:all .5s ease;display:flex;align-items:center;justify-content:center;text-align:center;position:relative}\n.ih-obj.key{width:62%;aspect-ratio:2.2/1;border-radius:18px;background:linear-gradient(135deg,#f0f0f0,#b9bec4 40%,#eceef0 58%,#9ea3a9);box-shadow:0 30px 60px rgba(0,0,0,.6)}\n.ih-obj.key:before{content:\"\";position:absolute;left:-34px;top:50%;width:46px;height:46px;border:7px solid #b9bec4;border-radius:50%;transform:translateY(-50%)}\n.ih-obj.pen{width:82%;height:13%;border-radius:40px;background:linear-gradient(180deg,#5a6168,#1e2226 45%,#3b4248);box-shadow:0 26px 50px rgba(0,0,0,.6)}\n.ih-obj.pen:after{content:\"\";position:absolute;right:-6%;top:50%;width:9%;height:60%;transform:translateY(-50%);background:linear-gradient(180deg,#e9e9e9,#9da2a7);clip-path:polygon(0 0,100% 50%,0 100%)}\n.ih-obj.bottle{width:34%;height:80%;border-radius:40px 40px 30px 30px;background:linear-gradient(90deg,#8d939a,#eef0f2 35%,#c4c9ce 60%,#7d838a);box-shadow:0 30px 60px rgba(0,0,0,.6)}\n.ih-obj.bottle:before{content:\"\";position:absolute;top:-9%;left:22%;width:56%;height:11%;background:#1b1e21;border-radius:10px 10px 4px 4px}\n.ih-txt{font-family:Fraunces,Georgia,serif;font-weight:600;color:rgba(70,74,79,.92);text-shadow:0 1px 0 rgba(255,255,255,.75),0 -1px 1px rgba(0,0,0,.45);letter-spacing:.06em;line-height:1.1;word-break:break-word;padding:0 8%}\n.ih-obj.key .ih-txt{font-size:clamp(1rem,2.6vw,1.7rem)}\n.ih-obj.pen .ih-txt{font-size:clamp(.7rem,1.6vw,1rem);color:rgba(235,224,205,.9);text-shadow:0 0 6px rgba(255,210,150,.35);letter-spacing:.2em;text-transform:uppercase}\n.ih-obj.bottle .ih-txt{font-size:clamp(.8rem,2vw,1.2rem);writing-mode:vertical-rl;transform:rotate(180deg);padding:0}\n.ih-beam{position:absolute;top:0;bottom:0;width:2px;background:linear-gradient(180deg,transparent,#ffcf8a,transparent);box-shadow:0 0 22px 6px rgba(255,180,90,.5);left:-10%;opacity:0}\n.ih-beam.go{animation:beam 1s ease}\n@keyframes beam{0%{left:10%;opacity:1}100%{left:90%;opacity:0}}\n/* products */\n.ih-pg{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}@media(min-width:900px){.ih-pg{grid-template-columns:repeat(4,1fr);gap:22px}}\n.ih-p{color:var(--ink);display:block}\n.ih-p .im{aspect-ratio:1/1;border-radius:16px;overflow:hidden;background:#eee;position:relative}\n.ih-p .im img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.ih-p:hover .im img{transform:scale(1.07)}\n.ih-p .im .q{position:absolute;left:10px;bottom:10px;background:rgba(255,255,255,.92);font-size:.72rem;font-weight:600;padding:.35rem .7rem;border-radius:99px;opacity:0;transform:translateY(6px);transition:.3s}\n.ih-p:hover .im .q{opacity:1;transform:none}\n.ih-p h4{font-size:.98rem;font-weight:600;margin:.9rem 0 .25rem}\n.ih-p .pp{color:var(--muted);font-size:.88rem}.ih-p .pp b{color:var(--ink)}\n/* steps */\n.ih-steps{background:var(--ink);color:#fff}\n.ih-st{display:grid;gap:0;margin-top:3rem;counter-reset:s}@media(min-width:900px){.ih-st{grid-template-columns:repeat(4,1fr)}}\n.ih-st div{padding:2rem 1.6rem 2rem 0;border-top:1px solid #3a3f44;position:relative}\n.ih-st div:before{content:\"\";position:absolute;top:-1px;left:0;width:0;height:2px;background:var(--brass);transition:width 1.2s ease}\n.ih-st.in div:before{width:100%}\n.ih-st b{font-family:Fraunces,Georgia,serif;font-size:3.2rem;color:var(--brass);font-weight:600;display:block;line-height:1}\n.ih-st h4{font-size:1.1rem;margin:1rem 0 .5rem}.ih-st p{color:#a9a9a9;font-size:.93rem}\n/* planner */\n.ih-plan{display:grid;gap:2rem;background:#fff;border:1px solid var(--line);border-radius:24px;padding:clamp(1.6rem,4vw,3rem)}@media(min-width:900px){.ih-plan{grid-template-columns:1fr 1fr;align-items:center}}\n.ih-plan label{display:block;font-size:.8rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:1.4rem}\n.ih-plan .v{font-family:Fraunces,Georgia,serif;font-size:2rem;color:var(--ink);text-transform:none;letter-spacing:0;display:block;margin:.3rem 0 .4rem}\n.ih-plan input[type=range]{width:100%;accent-color:#b8925a}\n.ih-res{background:var(--paper);border-radius:18px;padding:1.6rem}\n/* who */\n.ih-who{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}@media(min-width:900px){.ih-who{grid-template-columns:repeat(3,1fr);gap:18px}}\n.ih-w{border:1px solid var(--line);border-radius:18px;padding:1.6rem;background:#fff;transition:.3s}\n.ih-w:hover{background:var(--ink);color:#fff;border-color:var(--ink);transform:translateY(-4px)}.ih-w:hover p{color:#bbb}\n.ih-w .ic{font-size:1.6rem;margin-bottom:.8rem;display:block}\n.ih-w h4{font-family:Fraunces,Georgia,serif;font-size:1.25rem;margin:0 0 .4rem;font-weight:600}.ih-w p{color:var(--muted);font-size:.9rem}\n/* story + cta */\n.ih-story .g{display:grid;gap:3rem;align-items:center}@media(min-width:900px){.ih-story .g{grid-template-columns:1fr 1fr}}\n.ih-story .ph{aspect-ratio:4/5;border-radius:24px;background:#ccc center/cover no-repeat}\n.ih-story blockquote{font-family:Fraunces,Georgia,serif;font-size:clamp(1.4rem,2.6vw,2rem);line-height:1.25;margin:1rem 0 1.4rem;font-style:italic}\n.ih-pr{display:grid;gap:1rem;margin:1.6rem 0 2rem}.ih-pr div{display:flex;gap:1rem;align-items:flex-start}.ih-pr b{font-family:Fraunces,Georgia,serif;color:var(--brass);font-size:1.2rem;min-width:1.6rem}\n.ih-cta{background:var(--brass);color:var(--ink);text-align:center}\n.ih-cta h2{font-size:clamp(2.2rem,5vw,4rem);max-width:900px;margin:0 auto 1.2rem}\n</style><div class=\"ih\"><section class=\"ih-hero\"><div class=\"wrap g\">\n<div class=\"reveal\"><span class=\"eb\">Laser-engraved corporate gifts · Ajmer</span>\n<h1>Gifts with your name <em>cut into metal.</em></h1>\n<p class=\"lead\">Keychains, pens, bottles and ready gift kits — engraved in our own workshop, sampled free, and delivered ready to hand over. For shops, clinics, schools, dealerships and offices.</p>\n<div style=\"display:flex;gap:.8rem;flex-wrap:wrap\"><a class=\"btn b-brass\" href=\"/pages/get-a-quote\">Get a free sample →</a><a class=\"btn b-ghost\" href=\"https://wa.me/919109535267?text=Hi%2C%20I%27d%20like%20a%20free%20sample%20with%20my%20logo\">WhatsApp us</a></div>\n<div class=\"stats\"><div><b>24 hrs</b><span>Free mockup</span></div><div><b>50+</b><span>Pieces per order</span></div><div><b>100%</b><span>In-house</span></div></div></div>\n<div class=\"reveal\" style=\"position:relative\"><div class=\"pic\" style=\"background-image:url('{{ 'hero-laser-engraving.jpg' | file_url }}')\"><div class=\"scan\"></div></div><div class=\"tag\">YOUR LOGO</div></div>\n</div></section>\n<div class=\"ih-mq\"><div class=\"t\"><span>Car dealerships</span><i>✦</i><span>Clinics</span><i>✦</i><span>Schools</span><i>✦</i><span>Hotels & resorts</span><i>✦</i><span>Real estate</span><i>✦</i><span>Startups</span><i>✦</i><span>Wedding planners</span><i>✦</i><span>Offices</span><i>✦</i><span>Cafés</span><i>✦</i><span>Car dealerships</span><i>✦</i><span>Clinics</span><i>✦</i><span>Schools</span><i>✦</i><span>Hotels & resorts</span><i>✦</i><span>Real estate</span><i>✦</i><span>Startups</span><i>✦</i><span>Wedding planners</span><i>✦</i><span>Offices</span><i>✦</i><span>Cafés</span><i>✦</i></div></div></div>\n<script>(function(){var o=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');o.unobserve(x.target)}})},{threshold:.15});document.querySelectorAll('.ih .reveal,.ih .ih-st').forEach(function(el){o.observe(el)})})();</script>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"packages":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"ih\"><section class=\"ih-sec\"><div class=\"wrap\"><div class=\"ih-head\"><div><span class=\"eb\">Ready gift packages</span><h2>Pick a budget.<br>We handle the rest.</h2></div><p>Engraved, boxed, labelled and delivered — complete kits priced per person, GST included. Minimum 50 kits.</p></div><div class=\"ih-pk\">{%- for product in collections['ready-gift-packages'].products limit: 3 -%}{%- assign bulk = product.variants | where: 'title', 'Bulk — 50 kits' | first -%}{%- if bulk -%}{%- assign pp = bulk.price | divided_by: 50 -%}{%- else -%}{%- assign pp = product.price_min -%}{%- endif -%}{%- assign nm = product.title | split: ' (' | first -%}{%- assign inc = product.description | split: '</p>' | first | strip_html | remove: \"What's inside:\" | strip -%}\n<a class=\"ih-card{% if forloop.index == 2 %} dark{% endif %} reveal\" href=\"{{ product.url }}\" style=\"position:relative\">{% if forloop.index == 2 %}<span class=\"pop\">Most popular</span>{% endif %}<div class=\"im\">{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: nm }}</div><div class=\"bd\"><span class=\"tier\">{{ nm | split: ' ' | first }}</span><h3>{{ nm }}</h3><div class=\"pr\">{{ pp | money_without_trailing_zeros }} <small>/ person</small></div><p class=\"inc\">{{ inc }}</p><span class=\"go\">View package <span>→</span></span></div></a>{%- endfor -%}</div></div></section></div>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"demo":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"ih\"><section class=\"ih-sec ih-demo\"><div class=\"wrap g\">\n<div class=\"reveal\"><span class=\"eb\">Try it</span><h2>See your name engraved — right now.</h2><p style=\"color:var(--muted)\">Type your business name and pick a product. This is roughly how a fiber-laser engraving looks: permanent, crisp, and part of the metal itself.</p>\n<input id=\"ihN\" maxlength=\"28\" placeholder=\"Type your business name\" value=\"Your Business\">\n<div class=\"chips\"><button data-o=\"key\" class=\"on\">Keychain</button><button data-o=\"pen\">Pen</button><button data-o=\"bottle\">Bottle</button></div>\n<div style=\"margin-top:1.8rem;display:flex;gap:.8rem;flex-wrap:wrap\"><a class=\"btn b-dark\" href=\"https://wa.me/919109535267?text=Hi%2C%20I%27d%20like%20a%20free%20sample%20with%20my%20logo\">Get this as a free sample</a></div></div>\n<div class=\"ih-stage reveal\"><div id=\"ihO\" class=\"ih-obj key\"><span class=\"ih-txt\" id=\"ihT\">Your Business</span></div><div class=\"ih-beam\" id=\"ihB\"></div></div>\n</div></section></div>\n<script>(function(){var n=document.getElementById('ihN'),t=document.getElementById('ihT'),o=document.getElementById('ihO'),b=document.getElementById('ihB'),tm;\nfunction burn(){b.classList.remove('go');void b.offsetWidth;b.classList.add('go')}\nn.addEventListener('input',function(){t.textContent=n.value||'Your Business';clearTimeout(tm);tm=setTimeout(burn,250)});\ndocument.querySelectorAll('.ih-demo .chips button').forEach(function(x){x.addEventListener('click',function(){document.querySelectorAll('.ih-demo .chips button').forEach(function(y){y.classList.remove('on')});x.classList.add('on');o.className='ih-obj '+x.dataset.o;burn()})})})();</script>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"products":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"ih\"><section class=\"ih-sec\"><div class=\"wrap\"><div class=\"ih-head\"><div><span class=\"eb\">Engrave your logo on</span><h2>Things people actually keep.</h2></div><a class=\"btn b-line\" href=\"/collections/all\">View all products →</a></div><div class=\"ih-pg\">{%- assign items = collections['all'].products | sort: 'price' -%}{%- assign shown = 0 -%}{%- for product in items -%}{%- if product.type == 'Package' or shown >= 8 -%}{%- continue -%}{%- endif -%}{%- assign shown = shown | plus: 1 -%}{%- assign bulk = product.variants | where: 'title', 'Bulk pack — 50 pieces' | first -%}{%- if bulk -%}{%- assign pp = bulk.price | divided_by: 50 -%}{%- else -%}{%- assign pp = product.price_min -%}{%- endif -%}\n<a class=\"ih-p reveal\" href=\"{{ product.url }}\"><div class=\"im\">{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}<span class=\"q\">Min. 50 pcs · Free sample</span></div><h4>{{ product.title }}</h4><div class=\"pp\">From <b>{{ pp | money_without_trailing_zeros }}</b> / piece</div></a>{%- endfor -%}</div></div></section></div>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"steps":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"ih\"><section class=\"ih-sec ih-steps\"><div class=\"wrap\"><span class=\"eb\">How it works</span><h2 style=\"color:#fff;max-width:640px\">Zero risk. You see it before you pay a rupee.</h2>\n<div class=\"ih-st\"><div><b>01</b><h4>Send your logo</h4><p>On WhatsApp or our quote form — with rough quantity and budget.</p></div><div><b>02</b><h4>Free mockup in 24 hrs</h4><p>See exactly how your logo looks on the product.</p></div><div><b>03</b><h4>Hold a real sample</h4><p>A physical piece with your logo, delivered to you. No commitment.</p></div><div><b>04</b><h4>Delivered, ready to give</h4><p>Engraved, checked, boxed and delivered on the agreed date.</p></div></div>\n<div style=\"margin-top:2.4rem\"><a class=\"btn b-brass\" href=\"https://wa.me/919109535267?text=Hi%2C%20I%27d%20like%20a%20free%20sample%20with%20my%20logo\">Start with a free sample →</a></div></div></section></div>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"planner":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"ih\"><section class=\"ih-sec\" style=\"background:var(--paper)\"><div class=\"wrap\"><div class=\"ih-plan reveal\">\n<div><span class=\"eb\">Budget planner</span><h2>What can you gift on your budget?</h2><p style=\"color:var(--muted)\">Slide to set your budget per person and team size. We'll suggest a package and an estimated total — GST included.</p></div>\n<div><label>Budget per person<span class=\"v\" id=\"pbV\">₹500</span><input type=\"range\" id=\"pb\" min=\"100\" max=\"1500\" step=\"50\" value=\"500\"></label>\n<label>Number of people<span class=\"v\" id=\"pqV\">100</span><input type=\"range\" id=\"pq\" min=\"50\" max=\"1000\" step=\"10\" value=\"100\"></label>\n<div class=\"ih-res\" id=\"pr\"></div></div></div></div></section></div>\n<script>(function(){var K=[{n:\"Essential Gift Kit\",p:249,u:\"/products/essential-gift-kit-under-300\",d:\"Metal pen + keychain in a kraft gift box\"},{n:\"Executive Gift Kit\",p:549,u:\"/products/executive-gift-kit-under-600\",d:\"Steel bottle + metal pen in a branded box\"},{n:\"Signature Gift Kit\",p:1099,u:\"/products/signature-gift-kit-under-1-200\",d:\"Bottle, premium pen, card holder & keychain in a rigid box\"}];\nfunction t(q,p){return q>=250?Math.round(p*.82):q>=100?Math.round(p*.9):p}\nvar B=document.getElementById('pb'),Q=document.getElementById('pq'),R=document.getElementById('pr');\nfunction f(){var b=+B.value,q=+Q.value,k=null;document.getElementById('pbV').textContent='₹'+b;document.getElementById('pqV').textContent=q;\nfor(var i=0;i<K.length;i++){if(t(q,K[i].p)<=b)k=K[i]}\nif(!k){R.innerHTML='<b>Under ₹'+t(q,249)+' per person?</b><p style=\"margin-top:.4rem;color:#6b6b6b\">A single engraved keychain or pen works great — <a href=\"/collections/all\" style=\"color:#16181a;text-decoration:underline\">see products</a>.</p>';return}\nvar pp=t(q,k.p);R.innerHTML='<span class=\"eb\">We suggest</span><h3 style=\"font-family:Fraunces,Georgia,serif;font-size:1.6rem;margin:.5rem 0 .3rem\">'+k.n+'</h3><p style=\"color:#6b6b6b\">'+k.d+'</p><p style=\"margin:1rem 0 1.2rem;font-size:1.05rem\">₹'+pp+' × '+q+' = <b style=\"font-family:Fraunces,Georgia,serif;font-size:1.6rem\">₹'+(pp*q).toLocaleString('en-IN')+'</b></p><a class=\"btn b-dark\" href=\"'+k.u+'\">View package →</a>'}\nB.addEventListener('input',f);Q.addEventListener('input',f);f()})();</script>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"who":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"ih\"><section class=\"ih-sec\"><div class=\"wrap\"><div class=\"ih-head\"><div><span class=\"eb\">Who we work with</span><h2>Built for your kind of business.</h2></div><a class=\"btn b-line\" href=\"/pages/who-we-work-with\">All industries →</a></div><div class=\"ih-who\"><div class=\"ih-w reveal\"><span class=\"ic\">🚗</span><h4>Car & bike dealerships</h4><p>Key tag with each customer's vehicle number + your logo, handed over at every delivery.</p></div><div class=\"ih-w reveal\"><span class=\"ic\">🩺</span><h4>Clinics & hospitals</h4><p>Weighty metal pens and desk pieces for doctors, staff and partners.</p></div><div class=\"ih-w reveal\"><span class=\"ic\">🎓</span><h4>Schools & coaching</h4><p>Awards and farewell gifts engraved with each student's name.</p></div><div class=\"ih-w reveal\"><span class=\"ic\">🏨</span><h4>Hotels & resorts</h4><p>Room key tags and guest souvenirs for Ajmer & Pushkar properties.</p></div><div class=\"ih-w reveal\"><span class=\"ic\">🏢</span><h4>Real estate</h4><p>Engraved key tags at flat handover — kept for years.</p></div><div class=\"ih-w reveal\"><span class=\"ic\">💼</span><h4>Offices & startups</h4><p>Onboarding kits, work anniversaries and team rewards.</p></div></div></div></section></div>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"story":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"ih\"><section class=\"ih-sec ih-story\" style=\"background:var(--paper)\"><div class=\"wrap g\">\n<div class=\"ph reveal\" style=\"background-image:url('{{ 'workshop-laser.jpg' | file_url }}')\"></div>\n<div class=\"reveal\"><span class=\"eb\">Our story</span><blockquote>\"Branded gifts kept fading, peeling and getting thrown away. So we brought a laser home.\"</blockquote><p style=\"color:var(--muted)\">We're a family workshop in Ajmer. Engraving doesn't fade — it's cut into the metal. Every piece is made under our roof, checked by family, and sampled before you commit.</p>\n<div class=\"ih-pr\"><div><b>01</b><p><strong>See it before you pay.</strong> A free sample with your logo.</p></div><div><b>02</b><p><strong>Made in our own workshop.</strong> No outsourcing — quality and timing stay in our hands.</p></div><div><b>03</b><p><strong>Ready to hand over.</strong> Packed, labelled, GST invoice, on time.</p></div></div>\n<a class=\"btn b-line\" href=\"/pages/our-story\">Read our story →</a></div></div></section></div>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"cta":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"ih\"><section class=\"ih-sec ih-cta\"><div class=\"wrap\"><span class=\"eb\" style=\"color:var(--ink)\">Free · No commitment</span><h2>Send us your logo.<br>Hold a free sample in days.</h2>\n<div style=\"display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap;margin-top:1.8rem\"><a class=\"btn b-dark\" href=\"https://wa.me/919109535267?text=Hi%2C%20I%27d%20like%20a%20free%20sample%20with%20my%20logo\">WhatsApp +91 91095 35267</a><a class=\"btn b-line\" href=\"/pages/get-a-quote\">Request a quote</a></div></div></section></div>","background_