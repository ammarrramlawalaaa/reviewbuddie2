obile_card_size":"60cqw","columns_gap":8,"rows_gap":24,"icons_style":"arrow","icons_shape":"none","section_width":"page-width","horizontal_alignment":"flex-start","gap":28,"background_color":"#ffffff","padding-block-start":64,"padding-block-end":64}},"picker":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"tih\"><div style=\"background:var(--soft);padding:clamp(1.5rem,4vw,3rem);display:grid;gap:2rem\" class=\"tih-pick\">\n<div><span class=\"eyebrow\">Budget planner</span><h2>What fits your budget?</h2><p>Enter your budget per person and how many people. We'll suggest a ready package and an estimated total.</p></div>\n<div style=\"display:grid;gap:1rem\">\n<label style=\"font-size:.85rem;font-weight:600\">Budget per person (₹)<input id=\"tihB\" type=\"number\" min=\"50\" value=\"500\" style=\"display:block;width:100%;margin-top:.4rem;padding:.8rem;border:1px solid #ccc;background:#fff;font-size:1rem\"></label>\n<label style=\"font-size:.85rem;font-weight:600\">Number of people (min 50)<input id=\"tihQ\" type=\"number\" min=\"50\" value=\"100\" style=\"display:block;width:100%;margin-top:.4rem;padding:.8rem;border:1px solid #ccc;background:#fff;font-size:1rem\"></label>\n<div id=\"tihR\" style=\"background:#fff;border:1px solid var(--line);padding:1.2rem\"></div>\n</div></div>\n<style>@media(min-width:750px){.tih-pick{grid-template-columns:1fr 1fr;align-items:center}}</style>\n<script>(function(){var K=[{n:\"Essential Gift Kit\",p:249,u:\"/products/essential-gift-kit-under-300\",d:\"Metal pen + keychain in a kraft gift box\"},{n:\"Executive Gift Kit\",p:549,u:\"/products/executive-gift-kit-under-600\",d:\"Steel bottle + metal pen in a branded box\"},{n:\"Signature Gift Kit\",p:1099,u:\"/products/signature-gift-kit-under-1-200\",d:\"Bottle, premium pen, card holder & keychain in a rigid box\"}];\nfunction t(q,p){return q>=250?Math.round(p*.82):q>=100?Math.round(p*.9):p}\nfunction f(){var b=+document.getElementById('tihB').value||0,q=Math.max(50,+document.getElementById('tihQ').value||50),r=document.getElementById('tihR'),k=null;\nfor(var i=0;i<K.length;i++){if(t(q,K[i].p)<=b)k=K[i]}\nif(!k){r.innerHTML='<strong>Under ₹'+t(q,249)+' per person?</strong><p style=\"margin-top:.4rem\">Try a single engraved keychain or pen — <a href=\"/collections/all\" style=\"color:inherit\">see products</a>.</p>';return}\nvar pp=t(q,k.p);r.innerHTML='<span style=\"font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:#777\">Suggested</span><h3 style=\"margin:.3rem 0\">'+k.n+'</h3><p>'+k.d+'</p><p style=\"margin:.8rem 0;color:#1c1c1c\"><strong>₹'+pp+'</strong> per person × '+q+' = <strong>₹'+(pp*q).toLocaleString('en-IN')+'</strong> <span style=\"font-size:.8rem\">(estimate, incl. GST)</span></p><a class=\"btn btn-dark\" href=\"'+k.u+'\">View package</a>'}\n['tihB','tihQ'].forEach(function(id){document.getElementById(id).addEventListener('input',f)});f()})();</script></div>","background_color":"","section_width":"page-width","padding-block-start":24,"padding-block-end":24}},"who":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"tih\"><div class=\"center\"><span class=\"eyebrow\">Who we work with</span><h2>Gift ideas built for your business</h2><p>Tell us your industry and we'll suggest a gift that gets used — not thrown away.</p></div><div class=\"grid g3\"><div class=\"cell\"><h3 style=\"margin-top:0\">Car & bike dealerships</h3><p>Key tag with each customer's vehicle number + your logo, with every delivery.</p></div><div class=\"cell\"><h3 style=\"margin-top:0\">Clinics & hospitals</h3><p>Metal pens and desk items for doctors, staff and partners.</p></div><div class=\"cell\"><h3 style=\"margin-top:0\">Schools & coaching</h3><p>Awards and farewell gifts engraved with each student's name.</p></div><div class=\"cell\"><h3 style=\"margin-top:0\">Hotels & resorts</h3><p>Room key tags and guest souvenirs for Ajmer & Pushkar properties.</p></div><div class=\"cell\"><h3 style=\"margin-top:0\">Real estate</h3><p>Engraved key tags for flat handovers that buyers keep for years.</p></div><div class=\"cell\"><h3 style=\"margin-top:0\">Offices & startups</h3><p>Onboarding kits, work anniversaries and team rewards.</p></div></div><div style=\"text-align:center;margin-top:2rem\"><a class=\"btn btn-line\" href=\"/pages/who-we-work-with\">See all industries</a></div></div>","background_color":"#f6f6f4","section_width":"page-width","padding-block-start":72,"padding-block-end":72}},"story":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"tih\"><div style=\"display:grid;gap:2.5rem;align-items:center\" class=\"tih-story\">\n<img src=\"{{ 'workshop-laser.jpg' | file_url }}\" alt=\"Laser engraving in our workshop\" loading=\"lazy\" style=\"width:100%;aspect-ratio:4/3;object-fit:cover;display:block\">\n<div><span class=\"eyebrow\">Our story</span><h2>A family workshop in Ajmer</h2>\n<p style=\"margin-bottom:1rem\">We brought a precision laser in-house because branded gifts kept fading, peeling and getting thrown away. Engraving doesn't fade — it's cut into the metal.</p>\n<p style=\"margin-bottom:1.6rem\">Every piece is made in our own workshop, checked by family, and sampled before you commit.</p>\n<a class=\"btn btn-line\" href=\"/pages/our-story\">Read our story</a></div></div>\n<style>@media(min-width:750px){.tih-story{grid-template-columns:1fr 1fr}}</style></div>","background_color":"","section_width":"page-width","padding-block-start":72,"padding-block-end":72}},"cta":{"type":"custom-liquid","settings":{"custom_liquid":"<div class=\"tih\"><div style=\"background:#1c1c1c;color:#fff;text-align:center;padding:clamp(2.5rem,6vw,4.5rem) 1.5rem\">\n<h2 style=\"color:#fff\">Send us your logo. Get a free mockup in 24 hours.</h2>\n<p style=\"color:#cfcfcf;max-width:520px;margin:0 auto 1.8rem\">Free mockup, free physical sample, no commitment. Minimum order 50 pieces.</p>\n<div style=\"display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap\"><a class=\"btn btn-light\" href=\"https://wa.me/919109535267?text=Hi%2C%20I%27d%20like%20a%20free%20sample%20with%20my%20logo\">WhatsApp 91095 35267</a><a class=\"btn btn-line\" style=\"color:#fff\" href=\"/pages/get-a-quote\">Request a quote</a></div>\n</div></div>","background_color":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}}},"order":["hero","trust","packages","how","products","picker","who","story","cta"]}